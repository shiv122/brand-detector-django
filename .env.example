# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*

# CORS
CORS_ALLOWED_ORIGINS=*

# Defaults (optional — overrides for FPS, confidence, default weights)
# DEFAULT_WEIGHT=best.pt
# DEFAULT_CLASSIFICATION_WEIGHT=best_classify.pt
# DEFAULT_FPS=1
# DEFAULT_CONFIDENCE=0.5

# OCR pipeline:
#   Stage 1 — GLM-OCR via remote Ollama (the GLM_OCR container) for text extraction.
#   Stage 2 — DeepSeek text API formats the extracted text into JSON.
OCR_PROVIDER=local

# Stage 1: remote Ollama serving glm-ocr (point at the GLM_OCR container).
LOCAL_OCR_OLLAMA_HOST=http://glm-ocr:11434
LOCAL_OCR_OLLAMA_MODEL=glm-ocr
LOCAL_OCR_OLLAMA_TIMEOUT_SECONDS=180
# LOCAL_OCR_MAX_NEW_TOKENS=2048

# Stage 2 formatter provider — "deepseek" or "gemini".
# Gemini 2.5 Flash-Lite is ~2-3x faster than deepseek-chat for this workload.
TEXT_FORMATTER_PROVIDER=deepseek

# Stage 2 (deepseek): api.deepseek.com.
DEEPSEEK_TEXT_API_KEY=sk-your-deepseek-key
DEEPSEEK_TEXT_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEXT_MODEL=deepseek-chat
# DEEPSEEK_TEXT_TIMEOUT_SECONDS=60
# DEEPSEEK_TEXT_MAX_TOKENS=2048

# Stage 2 (gemini): Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_TEXT_API_KEY=
GEMINI_TEXT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
# GEMINI_TEXT_TIMEOUT_SECONDS=60
# GEMINI_TEXT_MAX_TOKENS=2048

# Redis (used by django-rq to offload OCR off the detection sync path).
REDIS_URL=redis://127.0.0.1:6379/0

# Debug logging for the OCR pipeline.
# OCR_LLM_DEBUG=1
