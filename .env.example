# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*

# CORS
CORS_ALLOWED_ORIGINS=*

# Database — external Postgres in production (Coolify). Leave unset to use a
# local sqlite file (dev only).
# DATABASE_URL=postgresql://user:password@db-host:5432/detector

# Redis — external instance for the OCR job queue (django-rq).
REDIS_URL=redis://redis:6379/0

# DigitalOcean Spaces (S3-compatible) — detection uploads each frame here and
# stores its public URL on the Frame row; OCR sends that URL to the GLM box.
DO_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_DEFAULT_REGION=blr1
DO_BUCKET=df-detection
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
# Override the public object URL base (e.g. a CDN domain). Default is the
# virtual-hosted Spaces domain derived from endpoint + bucket.
# DO_PUBLIC_BASE_URL=https://df-detection.blr1.cdn.digitaloceanspaces.com
# Key prefix for frame objects in the bucket.
# DO_FRAMES_PREFIX=frames

# Defaults (optional — overrides for FPS, confidence, default weights)
# DEFAULT_WEIGHT=best.pt
# DEFAULT_CLASSIFICATION_WEIGHT=best_classify.pt
# DEFAULT_FPS=1
# DEFAULT_CONFIDENCE=0.5

# OCR runs OUT OF BAND from detection, as an RQ job:
#   Stage 1 — the EXTERNAL extractor box (its own GPU) extracts text. Pick the
#             engine with OCR_ENGINE: "glm" (GLM-OCR) or "locate" (NVIDIA
#             LocateAnything — reads text + bounding boxes in one call).
#   Stage 2 — optional DeepSeek/Gemini formatter shapes it into JSON. Without
#             a formatter key, OCR returns the raw extracted text.
OCR_PROVIDER=local
OCR_ENGINE=glm

# Stage 1 (engine=glm): the external GLM OCR service (FastAPI /ocr, fetches the image URL).
GLM_OCR_HOST=http://glm-ocr:8080
GLM_OCR_MODEL=glm-ocr
GLM_OCR_TIMEOUT_SECONDS=120
# GLM_OCR_MAX_NEW_TOKENS=2048
# GLM_OCR_RETRIES=3
# GLM_OCR_RETRY_BASE_DELAY=1.0

# Stage 1 (engine=locate): the external LocateAnything service (FastAPI /locate).
# Leave LOCATE_QUERY blank for general OCR ("Detect all text in box format" —
# reads ALL visible text). A non-empty value searches for that literal text.
LOCATE_HOST=
LOCATE_TASK=ocr
LOCATE_QUERY=
LOCATE_TIMEOUT_SECONDS=180
# Longest image side before inference: bigger detects more (small) text but
# uses more GPU memory; 0 disables downscaling. Unset => service default.
# LOCATE_MAX_SIDE=1280
# LOCATE_MODE=hybrid
# LOCATE_MAX_NEW_TOKENS=2048

# Stage 2 formatter provider — "deepseek" or "gemini" (optional).
TEXT_FORMATTER_PROVIDER=deepseek

# Stage 2 (deepseek): api.deepseek.com.
DEEPSEEK_TEXT_API_KEY=
DEEPSEEK_TEXT_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEXT_MODEL=deepseek-chat

# Stage 2 (gemini): Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_TEXT_API_KEY=
GEMINI_TEXT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# OCR job tuning (external Redis).
# RQ_WORKERS=4
# RQ_OCR_TIMEOUT=600
# RQ_OCR_JOB_RETRIES=3

# Debug logging for the OCR pipeline.
# OCR_LLM_DEBUG=1
